#UPSTASH TOKENS
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Copy this to `.env` (or set as environment variables in your shell/Netlify)
# -------------------------
# Frontend (Create React App)
# -------------------------
# Show a small on-screen status overlay for the voice agent.
REACT_APP_VOICE_DEBUG=true
# Timeout for STT/LLM HTTP requests (ms)
REACT_APP_VOICE_REQUEST_TIMEOUT_MS=30000
# Wake word behavior:
# - Default is "aera" if unset.
# - Set to "off" to disable wake-word gating.
REACT_APP_WAKE_WORD=aera
# Dashboard mic orb (optional). Off by default to avoid fighting the voice agent for mic access.
# -------------------------
# Frontend (Create React App)
# -------------------------
# Dashboard mic orb (optional).
REACT_APP_DASHBOARD_AUDIO=false
# Override chat/STT endpoints. By default:
# - Netlify uses /.netlify/functions/*
# - Vercel/local uses /api/*
REACT_APP_CHAT_ENDPOINT=
REACT_APP_STT_ENDPOINT=
# Optional: force a specific Albanian TTS voice by name (from speechSynthesis.getVoices()).
REACT_APP_TTS_ALBANIAN_VOICE=
# Optional: use prerecorded MP3s for script mode (served from /public).
REACT_APP_SCRIPT_AUDIO_1=/public/audio/script-1.mp3
REACT_APP_SCRIPT_AUDIO_2=/public/audio/script-2.mp3
REACT_APP_SCRIPT_AUDIO_3=/public/audio/script-3.mp3
