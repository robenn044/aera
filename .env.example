# Copy this to `.env` (or set as environment variables in your shell/Netlify)

# -------------------------
# Frontend (Create React App)
# -------------------------
# Show a small on-screen status overlay for the voice agent.
REACT_APP_VOICE_DEBUG=true

# Timeout for STT/LLM HTTP requests (ms)
REACT_APP_VOICE_REQUEST_TIMEOUT_MS=30000

# Wake word behavior:
# - Default is "aera" if unset.
# - Set to "off" to disable wake-word gating.
REACT_APP_WAKE_WORD=aera

# Dashboard mic orb (optional). Off by default to avoid fighting the voice agent for mic access.
REACT_APP_DASHBOARD_AUDIO=false

# Voice activity detection tuning (optional)
# Higher start RMS = less sensitive; lower stop RMS = waits longer for silence.
REACT_APP_VAD_START_RMS=0.03
REACT_APP_VAD_STOP_RMS=0.017

# Optional: enable adaptive noise-floor VAD. Off by default (more reliable STT).
REACT_APP_VAD_ADAPTIVE=false
REACT_APP_VAD_NOISE_FLOOR_INIT=0.008

# Backoff/cooldowns after wake-misses or rejected prompts.
REACT_APP_VAD_WAKE_MISS_COOLDOWN_MS=1400
REACT_APP_VAD_REJECT_COOLDOWN_MS=1200

REACT_APP_MIN_RECORD_MS=450
REACT_APP_MAX_RECORD_MS=12000

# -------------------------
# Netlify Function (server-side)
# -------------------------
# Required for Groq calls:
GROQ_API_KEY=__PUT_YOUR_GROQ_KEY_HERE__

# Optional:
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=en
GROQ_STT_TEMPERATURE=0
GROQ_BASE_URL=https://api.groq.com/openai/v1
